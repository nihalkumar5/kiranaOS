// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentMode {
  CASH
  UPI
  CARD
  MIXED
}

enum OrderStatus {
  COMPLETED
  CANCELLED
}

enum OnlineOrderStatus {
  PENDING
  APPROVED
  READY
  PICKED_UP
  CANCELLED
}

enum OnlinePaymentStatus {
  PENDING
  PAID
}

enum OnlinePaymentMode {
  UPI
  CASH_ON_PICKUP
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  AUDIT_ADJUSTMENT
  RETURN
}

model Store {
  id                String   @id @default(uuid())
  name              String
  phone             String?
  address           String?
  gstin             String?
  storefrontEnabled Boolean  @default(false)
  themeColor        String   @default("#059669")
  logoUrl           String?
  bannerUrl         String?
  tagline           String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                 User[]
  products              Product[]
  categories            Category[]
  customers             Customer[]
  orders                Order[]
  inventoryTransactions InventoryTransaction[]
  onlineOrders          OnlineOrder[]
  cashTallies           CashTally[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  storeId      String
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store                Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders               Order[]
  inventoryTransactions InventoryTransaction[]
  cashTallies          CashTally[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, storeId])
}

model Product {
  id            String   @id @default(uuid())
  barcode       String?
  name          String
  image         String?
  categoryId    String?
  purchasePrice Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)
  stock         Decimal  @db.Decimal(10, 3) // Supports fractional stock like 1.500 kg
  unit          String   // kg, pcs, packet, l, etc.
  brand         String?
  gst           Decimal  @db.Decimal(5, 2)  // GST Percentage e.g. 18.00
  storeId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
  onlineOrderItems      OnlineOrderItem[]

  // Indexes for query speed
  @@unique([barcode, storeId])
  @@index([barcode])
  @@index([storeId])
}

model Customer {
  id        String   @id @default(uuid())
  mobile    String
  name      String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders       Order[]
  onlineOrders OnlineOrder[]

  @@unique([mobile, storeId])
  @@index([mobile])
  @@index([storeId])
}

model Order {
  id            String      @id @default(uuid())
  billNumber    String      // Store-scoped readable sequence (e.g. KOS-1001)
  storeId       String
  userId        String
  customerId    String?
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @db.Decimal(12, 2) @default(0.00)
  gstAmount     Decimal     @db.Decimal(12, 2)
  totalAmount   Decimal     @db.Decimal(12, 2)
  paymentMode   PaymentMode @default(CASH)
  status        OrderStatus @default(COMPLETED)
  whatsappSent  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@unique([billNumber, storeId])
  @@index([storeId])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Decimal  @db.Decimal(10, 3)
  price     Decimal  @db.Decimal(10, 2) // Price at purchase
  gstRate   Decimal  @db.Decimal(5, 2)  // GST rate percentage at purchase
  gstAmount Decimal  @db.Decimal(10, 2) // Calculated GST amount
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  storeId     String
  productId   String
  userId      String
  type        InventoryTransactionType
  quantity    Decimal                  @db.Decimal(10, 3) // Stock added (+) or removed (-)
  beforeStock Decimal                  @db.Decimal(10, 3)
  afterStock  Decimal                  @db.Decimal(10, 3)
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([storeId])
}

model OnlineOrder {
  id            String              @id @default(uuid())
  storeId       String
  customerId    String
  status        OnlineOrderStatus   @default(PENDING)
  subtotal      Decimal             @db.Decimal(12, 2)
  totalAmount   Decimal             @db.Decimal(12, 2)
  paymentStatus OnlinePaymentStatus @default(PENDING)
  paymentMode   OnlinePaymentMode   @default(CASH_ON_PICKUP)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OnlineOrderItem[]

  @@index([storeId])
  @@index([createdAt])
}

model OnlineOrderItem {
  id            String   @id @default(uuid())
  onlineOrderId String
  productId     String
  quantity      Decimal  @db.Decimal(10, 3)
  price         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  onlineOrder OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model CashTally {
  id             String   @id @default(uuid())
  storeId        String
  userId         String
  tallyDate      DateTime @default(now())
  expectedAmount Decimal  @db.Decimal(12, 2)
  actualAmount   Decimal  @db.Decimal(12, 2)
  difference     Decimal  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([tallyDate])
}
